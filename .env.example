# Copy this file to `.env` (same folder as docker-compose.yml) and fill in
# real values. `.env` must NEVER be committed — .gitignore already covers
# .env* under frontend/, but this root-level .env also needs to stay out of
# git; add it to the root .gitignore if it isn't already ignored.

# --- Postgres ---
POSTGRES_DB=ai_project
POSTGRES_USER=ai_project_user
POSTGRES_PASSWORD=change-me

# --- FastAPI resume-processing service (main.py) ---
# Rotate this in the CometAPI dashboard first — the old value was committed
# to the repo in plaintext and must be treated as leaked.
COMET_API_KEY=

# --- Spring Boot backend ---
# Any long random string works; used to sign JWTs — rotating it invalidates
# all existing sessions.
JWT_SECRET=change-me-to-a-long-random-string

# --- Next.js frontend ---
# ปกติไม่ต้องแก้ ปล่อยเป็น /api/v1 ไว้ทั้ง dev และ prod
#
# เป็น path ล้วน (ไม่มีโดเมน) โดยตั้งใจ — เบราว์เซอร์จะยิงมาที่ origin เดียวกับ
# หน้าเว็บ แล้ว Next.js proxy ต่อไปยัง backend ภายในเครือข่าย Docker ให้เอง
# (ดู rewrites ใน frontend/next.config.ts) ผลคือไม่มี CORS และ cookie
# ยังคงเป็น same-site เสมอ ไม่ว่าจะรันบน localhost หรือโดเมนจริง
#
# ถ้าตั้งเป็น URL เต็ม (เช่น https://api.example.com/api/v1) จะกลับไปเป็นการ
# เรียกข้าม origin ต้องไปเพิ่ม origin ใน APP_CORS_ALLOWED_ORIGINS เองด้วย
NEXT_PUBLIC_API_BASE_URL=/api/v1

# --- CORS (ใช้เฉพาะเวลาเรียก API ตรงโดยไม่ผ่าน proxy เช่น Swagger/Postman) ---
# คั่นหลายค่าด้วยเครื่องหมายจุลภาค ห้ามใช้ * เพราะเปิด allowCredentials อยู่
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth Client ID for "Sign in with Google" (Google Identity
# Services) — get one from
# https://console.cloud.google.com/apis/credentials, type "Web application",
# and add this deploy's origin under
# "Authorized JavaScript origins". Without this set, the Google sign-in
# button shows a clear "not configured" error instead of doing nothing.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- โปรไฟล์ที่จะใช้ (dev หรือ prod) ---
# ⚠️ ตัวคั่นหลายไฟล์ต่างกันตาม OS: Windows ใช้ ; ส่วน Linux/Mac ใช้ :
#    (บน Windows เครื่องหมาย : ถูกใช้เป็นตัวคั่นไดรฟ์ เช่น C: อยู่แล้ว)
# ปล่อยเป็นคอมเมนต์ไว้บนเครื่อง dev — จะใช้ docker-compose.yml อย่างเดียว
#
# บนเครื่อง production ให้ปลดคอมเมนต์บรรทัดล่างนี้ แล้วหลังจากนั้นสั่งแค่
#   docker compose up -d --build
# ก็จะรวมไฟล์ override ให้อัตโนมัติ ไม่ต้องพิมพ์ -f ยาว ๆ ทุกครั้ง
# COMPOSE_FILE=docker-compose.yml;docker-compose.prod.yml
#
# ถ้า deploy จากโน้ตบุ๊ก/เครื่องที่บ้าน (ไม่มี IP สาธารณะ) ให้ใช้บรรทัดนี้แทน
# COMPOSE_FILE=docker-compose.yml;docker-compose.tunnel.yml

# --- Cloudflare Tunnel (ใช้เฉพาะโปรไฟล์ docker-compose.tunnel.yml) ---
# ได้จาก Cloudflare Zero Trust > Networks > Tunnels > สร้าง tunnel > เลือก Docker
# แล้วก๊อปเฉพาะค่า token ที่ต่อท้าย --token ในคำสั่งที่ Cloudflare แสดงให้
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiMGIzMjVjOTQyNzE3ODQ0MTIyMzk1YTEyOWIyYTA5NWIiLCJ0IjoiOGUyMzhlZTUtMGZjMS00ZWZmLTlkOTktYzY1MmEyM2NhZDYwIiwicyI6Ik56RmpNek13WXpBdE1XVmpPQzAwWkRJeUxUazRNR010TnpjeFpEaG1Nak5qWW1ZMiJ9

