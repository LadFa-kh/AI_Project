# Copy this file to `.env` (same folder as docker-compose.yml) and fill in
# real values. `.env` must NEVER be committed — .gitignore already covers
# .env* under frontend/, but this root-level .env also needs to stay out of
# git; add it to the root .gitignore if it isn't already ignored.

# --- Postgres ---
POSTGRES_DB=ai_project
POSTGRES_USER=ai_project_user
POSTGRES_PASSWORD=change-me

# --- FastAPI resume-processing service (main.py) ---
# Rotate this in the CometAPI dashboard first — the old value was committed
# to the repo in plaintext and must be treated as leaked.
COMET_API_KEY=

# --- Spring Boot backend ---
# Any long random string works; used to sign JWTs — rotating it invalidates
# all existing sessions.
JWT_SECRET=change-me-to-a-long-random-string

# --- Next.js frontend ---
# Must be reachable from the end user's BROWSER (not from inside Docker) —
# e.g. https://api.yourdomain.com, not http://backend:8080.
NEXT_PUBLIC_API_BASE_URL=https://recommendation.site/api/v1

# Google OAuth Client ID for "Sign in with Google" (Google Identity
# Services) — get one from
# https://console.cloud.google.com/apis/credentials, type "Web application",
# and add this deploy's origin (https://app.recommendation.site) under
# "Authorized JavaScript origins". Without this set, the Google sign-in
# button shows a clear "not configured" error instead of doing nothing.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
