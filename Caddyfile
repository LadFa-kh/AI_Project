# Caddy = ทางเข้าเดียวจากอินเทอร์เน็ต ใช้กับ docker-compose.prod.yml เท่านั้น
#
# Caddy จะขอและต่ออายุใบรับรอง TLS จาก Let's Encrypt ให้อัตโนมัติตั้งแต่ครั้งแรก
# ที่สตาร์ท ไม่ต้องตั้งค่า cert เอง ขอแค่:
#   1. DNS: มี A (หรือ CNAME) record ของ app.recommendation.site ชี้มาที่ IP
#      สาธารณะของเครื่องนี้
#   2. port 80 และ 443 เข้าถึงได้จากภายนอก (port 80 จำเป็นสำหรับ ACME
#      HTTP-01 challenge ที่ Caddy ใช้พิสูจน์ความเป็นเจ้าของโดเมน หลังจากนั้น
#      จะ redirect ไป 443 ให้เอง)
#
# หมายเหตุเรื่อง auth: Caddy proxy เฉพาะ frontend เท่านั้น ส่วน request ที่
# ขึ้นต้นด้วย /api/* ตัว Next.js จะ proxy ต่อไปยัง backend ภายในเครือข่าย
# Docker ให้เอง (ดู rewrites ใน frontend/next.config.ts) ผลลัพธ์คือเบราว์เซอร์
# เห็นทุกอย่างอยู่บนโดเมนเดียว — cookie `accessToken` จึงเป็น same-site
# ตลอด ใช้ `SameSite=Lax` ได้ ไม่ต้องพึ่ง `SameSite=None` ซึ่งนับเป็น
# third-party cookie ที่เบราว์เซอร์กำลังทยอยเลิกรองรับ
# และ backend ไม่ต้องเปิด port ออกอินเทอร์เน็ตเลยแม้แต่ port เดียว

app.recommendation.site {
	reverse_proxy frontend:3000

	encode gzip

	# อัปโหลดเรซูเม่เป็น PDF ไม่เกิน 5MB (จำกัดฝั่ง backend อยู่แล้ว)
	# เผื่อไว้ 12MB กัน multipart overhead แล้วตัดคำขอที่ใหญ่ผิดปกติทิ้งแต่ต้นทาง
	request_body {
		max_size 12MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# บังคับ HTTPS ฝั่งเบราว์เซอร์ 1 ปี — สำคัญเพราะ cookie ติดธง Secure
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output file /var/log/caddy/app.recommendation.site.log
	}
}
