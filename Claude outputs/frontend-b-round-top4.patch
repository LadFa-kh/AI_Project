+}
+.btnApprove {
+  color: #ffffff;
+  background: linear-gradient(135deg, var(--color-home-hero-accent-1), var(--color-home-hero-accent-2));
+  border: 1px solid transparent;
+}
+.btnApprove:hover:not(:disabled) { filter: brightness(1.08); }
+.btnReject {
+  color: var(--nocturne-badge-admin-text);
+  background: transparent;
+  border: 1px solid rgba(236, 72, 153, 0.4);
+}
+.btnReject:hover:not(:disabled) { background: rgba(236, 72, 153, 0.1); }
+.btnApprove:disabled,
+.btnReject:disabled { opacity: 0.6; cursor: not-allowed; }
+.btnApprove:focus-visible,
+.btnReject:focus-visible { outline: 2px solid var(--color-home-hero-accent-1); outline-offset: 2px; }
+
+.btnDanger {
+  padding: 9px 16px;
+  font-family: inherit;
+  font-weight: 600;
+  font-size: 13px;
+  color: var(--nocturne-badge-admin-text);
+  background: rgba(236, 72, 153, 0.14);
+  border: 1px solid rgba(236, 72, 153, 0.5);
+  border-radius: 9px;
+  cursor: pointer;
+}
+.btnDanger:hover:not(:disabled) { background: rgba(236, 72, 153, 0.22); }
+.btnDanger:disabled { opacity: 0.6; cursor: not-allowed; }
