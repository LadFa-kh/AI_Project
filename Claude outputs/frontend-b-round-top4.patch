+.badgePending { color: var(--nocturne-warning-text); background: rgba(252, 131, 55, 0.14); border: 1px solid rgba(252, 131, 55, 0.4); }
+.badgeRejected { color: var(--nocturne-badge-admin-text); background: rgba(236, 72, 153, 0.12); border: 1px solid rgba(236, 72, 153, 0.36); }
+
+.btnApprove,
+.btnReject {
+  min-height: 30px;
+  padding: 5px 12px;
+  font-family: inherit;
