+        ) : (
+          <p className={styles.careerComplete}>คุณมีทักษะครบตามมาตรฐานของสายงานนี้แล้ว</p>
+        )}
+        {current.matchedSkills.length > 0 && (
+          <InsightChipList heading="ทักษะที่มีแล้ว" items={current.matchedSkills} tone="positive" />
+        )}
+      </div>
+    </section>
+  );
+}
